+/* One owned guest address-space reservation. Only mappings wholly inside this
+ * range may use MAP_FIXED; all other requested addresses are non-destructive
+ * hints which must match exactly. Reserving 4 GB consumes virtual space only.
+ * Setup/teardown happen before/after guest worker threads exist. */
+static void *s_guest_address_space;
+static size_t s_guest_address_space_size;
+
+static int in_guest_reservation(const void *address, size_t size)
+{
+    uintptr_t base = (uintptr_t)s_guest_address_space;
+    uintptr_t addr = (uintptr_t)address;
+    return base && addr >= base && size <= s_guest_address_space_size
+        && addr - base <= s_guest_address_space_size - size;
+}
+
+void *w32_reserve_guest_address_space(size_t size)
+{
+    if (s_guest_address_space || !size) return NULL;
+    void *p = mmap(NULL, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p == MAP_FAILED) { SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL; }
+    s_guest_address_space = p;
+    s_guest_address_space_size = size;
+    return p;
+}
+
+void w32_release_guest_address_space(void)
+{
+    if (s_guest_address_space)
+        munmap(s_guest_address_space, s_guest_address_space_size);
+    s_guest_address_space = NULL;
+    s_guest_address_space_size = 0;
