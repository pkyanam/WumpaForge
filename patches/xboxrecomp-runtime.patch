+++ b/src/kernel/xbox_optical_mode.h
@@ -0,0 +1,36 @@
+#ifndef XBOX_OPTICAL_MODE_H
+#define XBOX_OPTICAL_MODE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+/* Read-only media status for a mounted, accessible Xbox game image. This is
+ * MODE SENSE(10)'s eight-byte header plus Xbox's twenty-byte page 0x3e, as
+ * documented at https://xboxdevwiki.net/DVD_Drive#MODE_SENSE_and_MODE_SELECT.
+ * No optical-drive challenge, MODE SELECT or arbitrary SCSI command is
+ * implemented. The supplied image's Xbox partition is already accessible.
+ */
+static inline uint32_t xbox_optical_mode_sense(const uint8_t *cdb, size_t cdb_len,
+                                               uint8_t *data, size_t capacity,
+                                               size_t *written)
+{
+    if (written) *written = 0;
+    if (!cdb || cdb_len < 10 || !written) return 0xC000000Du;
+    if (cdb[0] != 0x5a || (cdb[1] & ~8u) || cdb[2] != 0x3e || cdb[3]
+        || cdb[4] || cdb[5] || cdb[6] || cdb[9]) return 0xC00000BBu;
+    size_t allocation = ((size_t)cdb[7] << 8) | cdb[8];
+    if (!data || capacity < 28 || allocation < 28) return 0xC0000023u;
+    uint8_t response[28] = {0};
+    response[1] = 26;       /* Mode data length excludes its own two bytes. */
+    response[3] = 0x80;     /* Read-only mounted optical media. */
+    response[8] = 0x3e;
+    response[9] = 18;
+    response[10] = 1;       /* Xbox partition selected. */
+    response[11] = 1;       /* Xbox game disc type. */
+    response[12] = 1;       /* Mounted partition already accessible. */
+    response[13] = 0xd0;    /* Xbox book type. */
+    memcpy(data, response, sizeof(response));
+    *written = sizeof(response);
+    return 0;
+}
+#endif
diff --git a/src/kernel/xbox_runtime_layout.h b/src/kernel/xbox_runtime_layout.h
new file mode 100644
index 0000000..7e61554
--- /dev/null
+++ b/src/kernel/xbox_runtime_layout.h
@@ -0,0 +1,45 @@
+#ifndef XBOX_RUNTIME_LAYOUT_H
+#define XBOX_RUNTIME_LAYOUT_H
+#include <stdint.h>
+
+/* Runtime-owned Xbox VAs sit after the entire supplied image, including BSS.
+ * The image keeps its original VAs. Only compatibility storage moves. */
+typedef struct XboxRuntimeLayout {
+    uint32_t rw_data, kernel_data, tls_struct, prcb;
+    uint32_t tls_block, tls_thread, stack_base, heap_base, stack_size;
+} XboxRuntimeLayout;
+
+static inline int xbox_plan_runtime_layout_with_stack(uint32_t image_end, uint32_t tls_bytes,
+                                           uint32_t requested_stack, uint32_t mapped_size,
+                                           XboxRuntimeLayout *layout)
+{
+    uint64_t base = ((uint64_t)image_end + 0xffffu) & ~UINT64_C(0xffff);
+    uint64_t tls_block = base + 0x70000u;
+    uint64_t tls_thread = (tls_block + tls_bytes + 63u) & ~UINT64_C(63);
+    uint64_t stack = (tls_thread + 64u + 0xffffu) & ~UINT64_C(0xffff);
+    /* Guest frames retain Xbox sizes; native C frames live on the host stack.
+     * Retain at least 256KB compatibility headroom, honoring larger XBE needs. */
+    uint64_t stack_size = requested_stack < 0x40000u ? 0x40000u : requested_stack;
+    stack_size = (stack_size + 0xffffu) & ~UINT64_C(0xffff);
+    uint64_t heap = stack + stack_size;
+    if (!layout || image_end < 0x10000u || heap >= mapped_size) return 0;
+    layout->rw_data = (uint32_t)base;
+    layout->kernel_data = (uint32_t)(base + 0x40000u);
+    layout->tls_struct = (uint32_t)(base + 0x60000u);
+    layout->prcb = (uint32_t)(base + 0x61000u);
+    layout->tls_block = (uint32_t)tls_block;
+    layout->tls_thread = (uint32_t)tls_thread;
+    layout->stack_base = (uint32_t)stack;
+    layout->heap_base = (uint32_t)heap;
+    layout->stack_size = (uint32_t)stack_size;
+    return 1;
+}
+
+/* Retain the original planner contract for existing external callers. Actual
+ * XBE loading uses the explicit stack-size planner above. */
+static inline int xbox_plan_runtime_layout(uint32_t image_end, uint32_t tls_bytes,
+                                           uint32_t mapped_size, XboxRuntimeLayout *layout)
+{
+    return xbox_plan_runtime_layout_with_stack(image_end,tls_bytes,8u*1024u*1024u,mapped_size,layout);
+}
+#endif
