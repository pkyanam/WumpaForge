diff --git a/src/audio/xbox_adpcm.c b/src/audio/xbox_adpcm.c
new file mode 100644
--- /dev/null
+++ b/src/audio/xbox_adpcm.c
@@ -0,0 +1,56 @@
+/* Xbox IMA ADPCM, 64-frame blocks. Algorithm/framing cross-checked against
+ * vgmstream decode_xbox_ima; see docs/ADPCM.md in the native title workspace.
+ * Integer shifts preserve the reference IMA expansion's rounding. */
+#include "xbox_adpcm.h"
+
+int xbox_adpcm_decode(const uint8_t *source, size_t bytes, unsigned channels,
+                      int16_t *output, size_t output_frames)
+{
+    static const int steps[89] = {
+        7,8,9,10,11,12,13,14,16,17,19,21,23,25,28,31,34,37,41,45,
+        50,55,60,66,73,80,88,97,107,118,130,143,157,173,190,209,
+        230,253,279,307,337,371,408,449,494,544,598,658,724,796,
+        876,963,1060,1166,1282,1411,1552,1707,1878,2066,2272,2499,
+        2749,3024,3327,3660,4026,4428,4871,5358,5894,6484,7132,
+        7845,8630,9493,10442,11487,12635,13899,15289,16818,18500,
+        20350,22385,24623,27086,29794,32767
+    };
+    static const int adjustment[8] = {-1,-1,-1,-1,2,4,6,8};
+    if ((channels != 1 && channels != 2) || !source || !output) return 0;
+    size_t block_bytes = 36u * channels;
+    if (!bytes || bytes % block_bytes || bytes / block_bytes > output_frames / 64u)
+        return 0;
+    /* Validate headers first, so malformed data cannot partly replace output. */
+    for (size_t block = 0; block < bytes; block += block_bytes)
+        for (unsigned ch = 0; ch < channels; ++ch)
+            if (source[block + ch * 4 + 2] > 88 || source[block + ch * 4 + 3])
+                return 0;
+    for (size_t block = 0; block < bytes; block += block_bytes) {
+        for (unsigned ch = 0; ch < channels; ++ch) {
+            const uint8_t *header = source + block + ch * 4;
+            int predictor = (int16_t)(header[0] | (header[1] << 8));
+            int index = header[2];
+            output[ch] = (int16_t)predictor;
+            for (unsigned frame = 1; frame < 64; ++frame) {
+                unsigned nibble = frame - 1;
+                size_t byte = block + 4 * channels + (nibble / 8) * 4 * channels
+                            + ch * 4 + (nibble % 8) / 2;
+                unsigned code = (source[byte] >> ((nibble & 1) * 4)) & 15;
+                int step = steps[index], delta = step >> 3;
+                if (code & 1) delta += step >> 2;
+                if (code & 2) delta += step >> 1;
+                if (code & 4) delta += step;
+                predictor += (code & 8) ? -delta : delta;
+                if (predictor < -32768) predictor = -32768;
+                if (predictor > 32767) predictor = 32767;
+                index += adjustment[code & 7];
+                if (index < 0) index = 0;
+                if (index > 88) index = 88;
+                output[frame * channels + ch] = (int16_t)predictor;
+            }
+        }
+        /* Last high nibble is deliberately unused: Xbox emits 64, not 65. */
+        output += 64 * channels;
+    }
+    return 1;
+}
diff --git a/src/audio/xbox_adpcm.h b/src/audio/xbox_adpcm.h
new file mode 100644
--- /dev/null
+++ b/src/audio/xbox_adpcm.h
@@ -0,0 +1,11 @@
+#ifndef XBOX_ADPCM_H
+#define XBOX_ADPCM_H
+#include <stddef.h>
+#include <stdint.h>
+/* 36 bytes per channel encode exactly 64 frames, including the predictor.
+ * Stereo stores both four-byte headers, then groups of four bytes per channel.
+ * Returns 1 on success. Rejects partial blocks, bad indices and short output;
+ * output is interleaved signed 16-bit PCM. No allocation or global state. */
+int xbox_adpcm_decode(const uint8_t *source, size_t bytes, unsigned channels,
+                      int16_t *output, size_t output_frames);
+#endif
