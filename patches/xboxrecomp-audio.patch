+    g_sdl_nonzero_in = g_sdl_nonzero_out = g_sdl_trace_next = 0;
+    g_sdl_peak_in = g_sdl_peak_out = 0;
+    g_sdl_submitted = g_sdl_played = g_sdl_underruns = g_sdl_overflows = 0;
