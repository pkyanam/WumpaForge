+
+int xa2_submit_samples(const int16_t *samples, int num_samples)
+{
+    if (!samples || num_samples <= 0 || num_samples > SDL_PCM_CAPACITY) return 0;
+    pthread_mutex_lock(&g_sdl_lifecycle);
+    if (!g_sdl_device) {
+        pthread_mutex_unlock(&g_sdl_lifecycle);
+        return 0;
+    }
+    SDL_LockAudioDevice(g_sdl_device);
+    unsigned frames = (unsigned)num_samples;
+    if (frames > SDL_PCM_CAPACITY - g_sdl_queued) {
+        /* Reject a whole submission; never truncate or grow latency. */
+        g_sdl_overflows++;
+        SDL_UnlockAudioDevice(g_sdl_device);
+        pthread_mutex_unlock(&g_sdl_lifecycle);
+        return 0;
+    }
+    unsigned write = (g_sdl_read + g_sdl_queued) % SDL_PCM_CAPACITY;
+    unsigned first = SDL_PCM_CAPACITY - write;
+    if (first > frames) first = frames;
+    memcpy(g_sdl_pcm[write], samples, first * SDL_PCM_FRAME_BYTES);
+    memcpy(g_sdl_pcm, samples + first * SDL_PCM_CHANNELS,
+           (frames - first) * SDL_PCM_FRAME_BYTES);
+    g_sdl_queued += frames;
+    g_sdl_submitted += frames;
+    if (g_sdl_trace) {
+        trace_energy(samples, frames, &g_sdl_nonzero_in, &g_sdl_peak_in);
+        if (g_sdl_submitted >= g_sdl_trace_next) {
+            fprintf(stderr, "[AUDIO-OUTPUT] submitted=%llu callback=%llu queued=%u nonzero_in=%llu nonzero_out=%llu peak_in=%u peak_out=%u underruns=%llu overflows=%llu\n",
+                (unsigned long long)g_sdl_submitted, (unsigned long long)g_sdl_played, g_sdl_queued,
+                (unsigned long long)g_sdl_nonzero_in, (unsigned long long)g_sdl_nonzero_out,
+                g_sdl_peak_in, g_sdl_peak_out, (unsigned long long)g_sdl_underruns, (unsigned long long)g_sdl_overflows);
+            g_sdl_trace_next = g_sdl_submitted + SDL_PCM_RATE;
+        }
+    }
+    int start = !g_sdl_started && g_sdl_queued >= SDL_PCM_PREROLL;
+    if (start) g_sdl_started = 1;
+    SDL_UnlockAudioDevice(g_sdl_device);
+    if (start) SDL_PauseAudioDevice(g_sdl_device, 0);
+    pthread_mutex_unlock(&g_sdl_lifecycle);
+    return 1;
+}
+
+int xa2_get_buffer_size(void)
+{
+    return SDL_PCM_SUBMISSION;
+}
 
