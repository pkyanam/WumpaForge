diff --git a/src/d3d/d3d8_present.inc b/src/d3d/d3d8_present.inc
new file mode 100644
index 0000000..6c8378e
--- /dev/null
+++ b/src/d3d/d3d8_present.inc
@@ -0,0 +1,169 @@
+/* Native output presentation. Internal game pixels/depth never resize with the
+ * Cocoa drawable; only the final image is scaled. Included after D3DGL globals. */
+static struct {
+    GLuint fbo[2], color[2], depth;
+    int width, height;
+    GLuint program, vao;
+    GLint u_source,u_size,u_sharpness;
+    const char *filter_source;
+    float sharpness;
+} g_output;
+
+GLuint xbox_D3D8GLBackBuffer(unsigned index)
+{ return index < 2 ? g_output.fbo[index] : 0; }
+
+GLuint xbox_D3D8GLDepthBuffer(void)
+{ return g_output.depth; }
+
+int xbox_D3D8GLSetPresentationFilter(const char *source,float strength)
+{
+    if (!source || !(strength>=0 && strength<=1)) return 0;
+    g_output.filter_source=source;
+    if (strength>0 && !g_output.program) {
+        const char *vs="#version 330 core\n out vec2 v_uv; void main(){vec2 p=vec2((gl_VertexID<<1)&2,gl_VertexID&2);v_uv=p;gl_Position=vec4(p*2.0-1.0,0,1);}";
+        GLuint shaders[2]={glCreateShader(GL_VERTEX_SHADER),glCreateShader(GL_FRAGMENT_SHADER)};
+        const char *sources[2]={vs,source};
+        int valid=1;
+        for(unsigned i=0;i<2;++i) {
+            glShaderSource(shaders[i],1,&sources[i],NULL);glCompileShader(shaders[i]);
+            GLint success;glGetShaderiv(shaders[i],GL_COMPILE_STATUS,&success);
+            if(!success) { char log[2048];glGetShaderInfoLog(shaders[i],sizeof(log),NULL,log);fprintf(stderr,"[d3d8_gl] presentation shader: %s\n",log);valid=0; }
+        }
+        GLuint program=glCreateProgram();
+        if(valid) {
+            glAttachShader(program,shaders[0]);glAttachShader(program,shaders[1]);glLinkProgram(program);
+            GLint success;glGetProgramiv(program,GL_LINK_STATUS,&success);valid=success;
+            if(!success) { char log[2048];glGetProgramInfoLog(program,sizeof(log),NULL,log);fprintf(stderr,"[d3d8_gl] presentation link: %s\n",log); }
+        }
+        glDeleteShader(shaders[0]);glDeleteShader(shaders[1]);
+        if(!valid) { glDeleteProgram(program);return 0; }
+        g_output.program=program;glGenVertexArrays(1,&g_output.vao);
+        g_output.u_source=glGetUniformLocation(program,"u_source");
+        g_output.u_size=glGetUniformLocation(program,"u_source_size");
+        g_output.u_sharpness=glGetUniformLocation(program,"u_sharpness");
+    }
+    g_output.sharpness=strength;
+    fprintf(stderr,"[d3d8_gl] output filter %s (strength%.2f)\n",strength>0?"bounded sharpening":"bilinear",strength);
+    return 1;
+}
+
+static void filtered_output(int x,int y,int width,int height)
+{
+    GLint program,vao,active,texture,sampler,viewport[4],polygon[2];
+    const GLenum states[]={GL_BLEND,GL_DEPTH_TEST,GL_STENCIL_TEST,GL_CULL_FACE,GL_RASTERIZER_DISCARD,GL_COLOR_LOGIC_OP,GL_FRAMEBUFFER_SRGB};
+    GLboolean enabled[sizeof(states)/sizeof(*states)];
+    for(unsigned i=0;i<sizeof(states)/sizeof(*states);++i){enabled[i]=glIsEnabled(states[i]);glDisable(states[i]);}
+    glGetIntegerv(GL_CURRENT_PROGRAM,&program);glGetIntegerv(GL_VERTEX_ARRAY_BINDING,&vao);
+    glGetIntegerv(GL_ACTIVE_TEXTURE,&active);glGetIntegerv(GL_VIEWPORT,viewport);
+    glGetIntegerv(GL_POLYGON_MODE,polygon);glPolygonMode(GL_FRONT_AND_BACK,GL_FILL);
+    glActiveTexture(GL_TEXTURE0);glGetIntegerv(GL_TEXTURE_BINDING_2D,&texture);glGetIntegerv(GL_SAMPLER_BINDING,&sampler);
+    glBindTexture(GL_TEXTURE_2D,g_output.color[0]);glBindSampler(0,0);
+    glUseProgram(g_output.program);glBindVertexArray(g_output.vao);glViewport(x,y,width,height);
+    glUniform1i(g_output.u_source,0);
+    glUniform2f(g_output.u_size,(float)g.backbuf_w,(float)g.backbuf_h);
+    glUniform1f(g_output.u_sharpness,g_output.sharpness);
+    glDrawArrays(GL_TRIANGLES,0,3);
+    glUseProgram(program);glBindVertexArray(vao);glViewport(viewport[0],viewport[1],viewport[2],viewport[3]);
+    glBindSampler(0,sampler);glBindTexture(GL_TEXTURE_2D,texture);glActiveTexture(active);
+    glPolygonMode(GL_FRONT_AND_BACK,polygon[0]);
+    for(unsigned i=0;i<sizeof(states)/sizeof(*states);++i)if(enabled[i])glEnable(states[i]);
+}
+
+static int init_output_buffers(void)
+{
+    if (g.backbuf_w > 4096 || g.backbuf_h > 4096) return 0;
+    GLint texture, renderbuffer;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    glGetIntegerv(GL_RENDERBUFFER_BINDING, &renderbuffer);
+    glGenFramebuffers(2, g_output.fbo);
+    glGenTextures(2, g_output.color);
+    glGenRenderbuffers(1, &g_output.depth);
+    glBindRenderbuffer(GL_RENDERBUFFER, g_output.depth);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, g.backbuf_w, g.backbuf_h);
+    int valid=1;
+    for (unsigned i=0;i<2;++i) {
+        glBindTexture(GL_TEXTURE_2D, g_output.color[i]);
+        glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA8,g.backbuf_w,g.backbuf_h,0,GL_RGBA,GL_UNSIGNED_BYTE,NULL);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER,g_output.fbo[i]);
+        glFramebufferTexture2D(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,g_output.color[i],0);
+        if (!i) glFramebufferRenderbuffer(GL_FRAMEBUFFER,GL_DEPTH_STENCIL_ATTACHMENT,GL_RENDERBUFFER,g_output.depth);
+        glDrawBuffer(GL_COLOR_ATTACHMENT0); glReadBuffer(GL_COLOR_ATTACHMENT0);
+        if (glCheckFramebufferStatus(GL_FRAMEBUFFER)!=GL_FRAMEBUFFER_COMPLETE) valid=0;
+        glClearColor(0,0,0,1);
+        glClear(GL_COLOR_BUFFER_BIT | (i?0:GL_DEPTH_BUFFER_BIT|GL_STENCIL_BUFFER_BIT));
+    }
+    glBindTexture(GL_TEXTURE_2D,texture); glBindRenderbuffer(GL_RENDERBUFFER,renderbuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER,g_output.fbo[0]);
+    return valid;
+}
+
+/* Caller is Cocoa main and owns the recursive native device lock. Workers use
+ * only these cached pixel dimensions, never SDL window/view APIs. */
+static void refresh_output_size(void)
+{
+    if (!g.window) return;
+    int width=0,height=0;
+    SDL_GL_GetDrawableSize(g.window,&width,&height);
+    if (width!=g_output.width || height!=g_output.height) {
+#ifdef __APPLE__
+        if (g_cgl) CGLUpdateContext(g_cgl);
+#endif
+        g_output.width=width; g_output.height=height;
+    }
+}
+
+static void output_event(const SDL_Event *event)
+{
+    if (event->type!=SDL_KEYDOWN || event->key.repeat ||
+        event->key.windowID!=SDL_GetWindowID(g.window)) return;
+    SDL_Keycode key=event->key.keysym.sym;
+    SDL_Keymod mods=(SDL_Keymod)event->key.keysym.mod;
+    if (key==SDLK_F10 && g_output.filter_source) {
+        if (!xbox_D3D8GLSetPresentationFilter(g_output.filter_source,g_output.sharpness>0?0:.25f))
+            fprintf(stderr,"[d3d8_gl] output filter toggle failed\n");
+    }
+    if (key==SDLK_F11 || (key==SDLK_f && (mods&KMOD_GUI) && (mods&KMOD_CTRL))) {
+        Uint32 mode=SDL_GetWindowFlags(g.window)&SDL_WINDOW_FULLSCREEN_DESKTOP;
+        if (SDL_SetWindowFullscreen(g.window,mode?0:SDL_WINDOW_FULLSCREEN_DESKTOP)<0)
+            fprintf(stderr,"[d3d8_gl] fullscreen toggle failed: %s\n",SDL_GetError());
+        refresh_output_size();
+    }
+}
+
+/* Also exported for a focused GPU readback before the window swap. This draws
+ * only the actual game image. Preserve every GL state changed by presentation. */
+void xbox_D3D8GLPresentImage(void)
+{
+    if (g_output.width<=0 || g_output.height<=0) return;
+    GLint read_fbo,draw_fbo,read_buffer,draw_buffer;
+    GLfloat clear[4]; GLboolean mask[4],scissor=glIsEnabled(GL_SCISSOR_TEST);
+    GLboolean discard=glIsEnabled(GL_RASTERIZER_DISCARD),srgb=glIsEnabled(GL_FRAMEBUFFER_SRGB);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&read_fbo);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&draw_fbo);
+    glGetIntegerv(GL_READ_BUFFER,&read_buffer); glGetIntegerv(GL_DRAW_BUFFER,&draw_buffer);
+    glGetFloatv(GL_COLOR_CLEAR_VALUE,clear); glGetBooleanv(GL_COLOR_WRITEMASK,mask);
+    glDisable(GL_SCISSOR_TEST); glDisable(GL_RASTERIZER_DISCARD); glDisable(GL_FRAMEBUFFER_SRGB); glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+    /* Front-surface reads see the last fully presented image at game size. */
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,g_output.fbo[0]); glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,g_output.fbo[1]); glDrawBuffer(GL_COLOR_ATTACHMENT0);
+    glBlitFramebuffer(0,0,g.backbuf_w,g.backbuf_h,0,0,g.backbuf_w,g.backbuf_h,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,0); glDrawBuffer(GL_BACK);
+    glClearColor(0,0,0,1); glClear(GL_COLOR_BUFFER_BIT);
+    int width=g_output.width,height=(int)((int64_t)width*g.backbuf_h/g.backbuf_w);
+    if (height>g_output.height) { height=g_output.height; width=(int)((int64_t)height*g.backbuf_w/g.backbuf_h); }
+    int x=(g_output.width-width)/2,y=(g_output.height-height)/2;
+    if (width>0 && height>0) {
+        if(g_output.sharpness>0)filtered_output(x,y,width,height);
+        else glBlitFramebuffer(0,0,g.backbuf_w,g.backbuf_h,x,y,x+width,y+height,GL_COLOR_BUFFER_BIT,GL_LINEAR);
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,read_fbo); glReadBuffer(read_buffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,draw_fbo); glDrawBuffer(draw_buffer);
+    glClearColor(clear[0],clear[1],clear[2],clear[3]); glColorMask(mask[0],mask[1],mask[2],mask[3]);
+    if(scissor)glEnable(GL_SCISSOR_TEST);
+    if(discard)glEnable(GL_RASTERIZER_DISCARD);
+    if(srgb)glEnable(GL_FRAMEBUFFER_SRGB);
+}
