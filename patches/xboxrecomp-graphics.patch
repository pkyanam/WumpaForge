+static struct {
+    int mode, distance;
+    float parameters[2], plane[4], color[3];
+} g_fixed_fog;
+void xbox_D3D8GLSetFixedFog(int mode, int distance, const float parameters[2],
+                          const float plane[4], const float color[3])
+{
+    g_fixed_fog.mode=mode; g_fixed_fog.distance=distance;
+    memcpy(g_fixed_fog.parameters,parameters,sizeof(g_fixed_fog.parameters));
