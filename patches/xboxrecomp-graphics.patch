+/* Optional timing uses CPU clocks only: never forces GPU completion. The
+ * existing device lock protects counters; keep main and loading-worker windows
+ * separate. Report once per60 presents, not once per draw. */
+static void profile_present(uint64_t start,uint64_t swap_end,uint64_t pace_end,uint64_t end)
+{
+    static struct { unsigned n; uint64_t driver,pace,pump,maximum; } frames[2];
+    unsigned index=0;
+#ifdef __APPLE__
+    index=!pthread_main_np();
+#endif
+    frames[index].driver+=swap_end-start;
+    frames[index].pace+=pace_end-swap_end;
+    frames[index].pump+=end-pace_end;
+    if(end-start>frames[index].maximum) frames[index].maximum=end-start;
+    if(++frames[index].n==60) {
+        fprintf(stderr,"[wrath present profile] thread=%s driver_ms=%.3f pace_ms=%.3f pump_ms=%.3f max_present_ms=%.3f\n",
+            index?"worker":"main",frames[index].driver/60e6,frames[index].pace/60e6,
+            frames[index].pump/60e6,frames[index].maximum/1e6);
+        fprintf(stderr,"[wrath context profile] thread=%s context_timing=%d acquires=%llu releases=%llu mutex_wait_ms=%.3f cgl_lock_ms=%.3f bind_ms=%.3f detach_ms=%.3f cgl_unlock_ms=%.3f mutex_unlock_ms=%.3f draws=%llu draw_driver_ms=%.3f event_pumps=%llu event_pump_ms=%.3f\n",
+            index?"worker":"main",profile_context_enabled(),(unsigned long long)g_profile_calls.acquires,(unsigned long long)g_profile_calls.releases,
+            g_profile_calls.mutex_wait/60e6,g_profile_calls.cgl_lock/60e6,g_profile_calls.bind/60e6,
+            g_profile_calls.detach/60e6,g_profile_calls.cgl_unlock/60e6,g_profile_calls.mutex_unlock/60e6,
+            (unsigned long long)g_profile_calls.draws,g_profile_calls.draw_time/60e6,
+            (unsigned long long)g_profile_calls.event_pumps,g_profile_calls.event_pump_time/60e6);
+        memset(&g_profile_calls,0,sizeof(g_profile_calls));
+        memset(&frames[index],0,sizeof(frames[index]));
+    }
+}
