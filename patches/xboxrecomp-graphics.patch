+
+static uint64_t g_present_period_ns = 1000000000ull / 60;
+static uint64_t g_present_deadline_ns;
+
+static uint64_t monotonic_ns(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) abort();
+    return (uint64_t)now.tv_sec * 1000000000ull + (uint64_t)now.tv_nsec;
+}
+static int profile_present_enabled(void)
+{
+    static _Thread_local int enabled=-1;
+    if (enabled<0) { const char *v=getenv("WRATH_PROFILE"); enabled=v&&!strcmp(v,"1"); }
+    return enabled;
+}
+/* High-frequency lock timing needs separate opt-in: retail SDK calls can
+ * acquire/release the device tens of thousands of times per frame. */
+static int profile_context_enabled(void)
+{
+    static _Thread_local int enabled=-1;
+    if(enabled<0) { const char *v=getenv("WRATH_PROFILE_CONTEXT"); enabled=profile_present_enabled()&&v&&!strcmp(v,"1"); }
+    return enabled;
+}
+typedef struct ProfileCalls {
+    uint64_t acquires,releases,mutex_wait,cgl_lock,bind,detach,cgl_unlock,mutex_unlock;
+    uint64_t draws,draw_time,event_pumps,event_pump_time;
+} ProfileCalls;
+static _Thread_local ProfileCalls g_profile_calls;
+uint64_t xbox_D3D8GLProfileDrawBegin(void)
+{ return profile_present_enabled()?monotonic_ns():0; }
+void xbox_D3D8GLProfileDrawEnd(uint64_t start)
+{
+    if(!start) return;
+    g_profile_calls.draw_time+=monotonic_ns()-start;
+    ++g_profile_calls.draws;
