+/* Some macOS drivers return from a swap before the requested refresh interval.
+ * Cap completion using one monotonic schedule for both rendering threads. Work
+ * already spent in the driver counts toward the interval; never add a fixed
+ * sleep after a blocking swap. The caller holds the device/context mutex. */
+static void pace_present(void)
+{
+    uint64_t now = monotonic_ns();
+    if (!g_present_deadline_ns) {
+        g_present_deadline_ns = now + g_present_period_ns;
+        return;
+    }
+    while (now < g_present_deadline_ns) {
+        uint64_t remaining = g_present_deadline_ns - now;
+        struct timespec wait = {(time_t)(remaining / 1000000000ull),
+                                (long)(remaining % 1000000000ull)};
+        if (nanosleep(&wait, NULL) && errno != EINTR) abort();
+        now = monotonic_ns();
+    }
+    if (now - g_present_deadline_ns >= g_present_period_ns)
+        g_present_deadline_ns = now + g_present_period_ns;
+    else
+        g_present_deadline_ns += g_present_period_ns;
+}
+
+/* The Xbox has one device shared by its loading worker and main thread. Keep
+ * both its host state and its context serialized. On Cocoa the SDL window and
+ * SDL context APIs remain main-thread-only; CGL provides the native worker
+ * context binding and swap without dispatching synchronously to the UI thread. */
+static pthread_once_t g_context_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t g_context_mutex;
+static _Thread_local unsigned g_context_depth;
+#ifdef __APPLE__
+static CGLContextObj g_cgl;
+static _Thread_local int g_cgl_locked;
+#endif
+static void init_context_mutex(void)
+{
+    pthread_mutexattr_t attr;
+    if (pthread_mutexattr_init(&attr) ||
+        pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE) ||
+        pthread_mutex_init(&g_context_mutex, &attr)) abort();
+    pthread_mutexattr_destroy(&attr);
+}
+int xbox_D3D8GLAcquire(void)
+{
+    pthread_once(&g_context_once, init_context_mutex);
+    int profiling=!g_context_depth && profile_context_enabled();
+    uint64_t begin=profiling?monotonic_ns():0;
+    if (pthread_mutex_lock(&g_context_mutex)) abort();
+    if (g_context_depth++) return 1;
+    uint64_t locked=profiling?monotonic_ns():0;
+    if(profiling) { ++g_profile_calls.acquires; g_profile_calls.mutex_wait+=locked-begin; }
+#ifdef __APPLE__
+    if (g_cgl) {
+        if (CGLLockContext(g_cgl) != kCGLNoError) goto fail;
+        uint64_t cgl_locked=profiling?monotonic_ns():0;
+        if(profiling) g_profile_calls.cgl_lock+=cgl_locked-locked;
+        g_cgl_locked = 1;
+        if (CGLSetCurrentContext(g_cgl) != kCGLNoError) goto fail;
+        if(profiling) g_profile_calls.bind+=monotonic_ns()-cgl_locked;
+    }
+#else
+    if (g.glctx && SDL_GL_MakeCurrent(g.window, g.glctx) < 0) goto fail;
+    if(profiling) g_profile_calls.bind+=monotonic_ns()-locked;
+#endif
+    return 1;
+fail:
+#ifdef __APPLE__
+    if (g_cgl_locked) { CGLUnlockContext(g_cgl); g_cgl_locked = 0; }
+#endif
+    g_context_depth = 0;
+    pthread_mutex_unlock(&g_context_mutex);
+    fprintf(stderr, "[d3d8_gl] failed to acquire native GL context\n");
+    return 0;
+}
+void xbox_D3D8GLRelease(void)
+{
+    if (!g_context_depth) abort();
+    int profiling=g_context_depth==1 && profile_context_enabled();
+    uint64_t begin=profiling?monotonic_ns():0;
+    if (--g_context_depth == 0) {
+#ifdef __APPLE__
+        if (g_cgl_locked) {
+            if (CGLSetCurrentContext(NULL) != kCGLNoError) abort();
+            uint64_t detached=profiling?monotonic_ns():0;
+            if(profiling) g_profile_calls.detach+=detached-begin;
+            CGLUnlockContext(g_cgl);
+            if(profiling) g_profile_calls.cgl_unlock+=monotonic_ns()-detached;
+            g_cgl_locked = 0;
+        }
+#else
+        if (g.glctx && SDL_GL_MakeCurrent(g.window, NULL) < 0) abort();
+        if(profiling) g_profile_calls.detach+=monotonic_ns()-begin;
+#endif
+    }
+    uint64_t unlock_begin=profiling?monotonic_ns():0;
+    pthread_mutex_unlock(&g_context_mutex);
+    if(profiling) { ++g_profile_calls.releases; g_profile_calls.mutex_unlock+=monotonic_ns()-unlock_begin; }
+}
+#include "d3d8_present.inc"
+
+void xbox_D3D8GLPumpEvents(void)
+{
+#ifdef __APPLE__
+    if (!pthread_main_np()) return;
+#endif
+    static uint64_t last_pump_ns;
+    uint64_t now = monotonic_ns();
+    if (last_pump_ns && now - last_pump_ns < 16000000ull) return;
+    uint64_t profile_pump=profile_present_enabled()?monotonic_ns():0;
+    if (!xbox_D3D8GLAcquire()) abort();
+    if (g.window) {
+        last_pump_ns = now;
+        SDL_Event ev;
+        while (SDL_PollEvent(&ev)) {
+            output_event(&ev);
+            if (ev.type == SDL_QUIT) {
+                fprintf(stderr, "[d3d8_gl] window close requested\n");
+                /* This is a host app quit, not a fabricated guest return.
+                 * End the process without freeing guest RAM beneath workers. */
+                exit(EXIT_SUCCESS);
+            }
+        }
+    }
+    refresh_output_size();
+    xbox_D3D8GLRelease();
+    if(profile_pump) { ++g_profile_calls.event_pumps; g_profile_calls.event_pump_time+=monotonic_ns()-profile_pump; }
+}
 
