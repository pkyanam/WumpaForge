+def merge_flag_states(states):
+    """Meet known predecessor states without discarding compatible snapshots.
+
+    CMP/TEST already write runtime operand snapshots on every incoming path.
+    The operands' identities therefore need not agree, only operation and width
+    (SF conditions still select a width-specific cast). Different CMP/TEST
+    semantics meet at captured ZF only. Unknown states and other unlike setters
+    that re-read operands are not merged.
+    """
+    if not states or any(state is None for state in states):
+        return None
+    first = states[0]
+    if all(state == first for state in states[1:]):
+        return first
+
+    def snapshot_signature(state):
+        kind, ops = state
+        if kind not in ("cmp", "test") or len(ops) != 2:
+            return None
+        width = _operand_width(ops[0]) or _operand_width(ops[1]) or 4
+        return kind, width
+
+    signature = snapshot_signature(first)
+    if signature is not None and all(snapshot_signature(state) == signature
+                                     for state in states[1:]):
+        return first
+    # Every CMP/TEST captures its width-masked zero flag on the executed path.
+    # Mixed kinds/widths can safely share ZF, but no other condition bits.
+    if all(state[0] == "snapshot_zf" or snapshot_signature(state) is not None
+           for state in states):
+        return ("snapshot_zf", [])
+    return None
+
+
+def advance_flag_state(curr, state):
+    """Pure flag transfer shared by CFG analysis and instruction emission."""
+    m = curr.mnemonic
+    # A CALL instruction preserves EFLAGS, but its callee can change them.
+    # No interprocedural flag-return contract is represented here.
+    if curr.is_call or m == "popfd": return None
+    if m in FLAG_SETTERS: return (m, list(curr.operands))
+    if m in _FLAGS_UNDEFINED: return None
+    if m in _EFLAGS_SETTERS: return (m, list(curr.operands))
+    if m in _EFLAGS_PRESERVE: return state
+    if m in ("fcompi", "fcomip", "fucomi", "fucompi", "fucomip", "fcomi", "sahf"):
+        return (m, list(curr.operands))
+    if m.startswith(("f", "cmov", "j", "set")): return state
+    if m.startswith("rep"):
+        rest = getattr(curr, "op_str", "")
+        if any(x in m or x in rest for x in ("cmpsb", "scasb")):
+            return (m, list(curr.operands))
+        return state
+    return None
+
+
+def block_flag_state(bb, incoming=None):
+    state = incoming
+    for insn in bb.instructions:
+        state = advance_flag_state(insn, state)
+    return state
+
