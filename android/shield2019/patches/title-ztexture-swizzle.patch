+/* Morton X/Y bits occupy disjoint positions even for rectangular dimensions.
+ * Bound scratch to128KiB and preserve the original per-pixel path on failure. */
+static uint32_t *morton_x_offsets(uint32_t width,uint32_t height)
+{
+    if(!width || width>128u*1024u/sizeof(uint32_t))return NULL;
+    uint32_t *offsets=malloc((size_t)width*sizeof(*offsets));
+    if(offsets)for(uint32_t x=0;x<width;++x)offsets[x]=morton_index(x,0,width,height);
+    return offsets;
+}
