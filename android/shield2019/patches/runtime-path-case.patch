+/* Xbox paths are case-insensitive; retain actual host spelling. No renames.
+ * Only sibling entries are scanned, and only for a missing exact name on
+ * case-sensitive hosts. No process-wide cache can go stale after save writes. */
+#include <dirent.h>
+#include <string.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/stat.h>
+static int xbox_ascii_equal(const char *a, const char *b)
+{
+    for (; *a && *b; ++a, ++b) {
+        unsigned char x=(unsigned char)*a, y=(unsigned char)*b;
+        if (x>='A' && x<='Z') x+=32;
+        if (y>='A' && y<='Z') y+=32;
+        if (x!=y) return 0;
+    }
+    return *a==*b;
+}
+static int xbox_case_path(const char *root, const char *relative, char *out,
+                          size_t capacity, int missing_parents)
+{
+    char normalized[MAX_PATH], actual[MAX_PATH], result[MAX_PATH];
+    size_t positions[MAX_PATH/2+1], depth=0, length=0;
+    int directory=-1, absent=0, ok=0;
+    if (!root || !relative || !out || !capacity) {errno=EINVAL;return 0;}
+    out[0]=0;
+    /* Normalize within the mapped root, never allow guest '..' to escape. */
+    const char *p=relative;
+    while (*p) {
+        while (*p=='/') ++p;
+        const char *start=p;while (*p && *p!='/')++p;
+        size_t n=(size_t)(p-start);if(!n)break;
+        if(n==1 && start[0]=='.')continue;
+        if(n==2 && start[0]=='.' && start[1]=='.') {
+            if(!depth){errno=EACCES;return 0;}
+            length=positions[--depth];continue;
+        }
+        if(length+n+1>=sizeof(normalized) || depth>=sizeof(positions)/sizeof(*positions)){errno=ENAMETOOLONG;return 0;}
+        positions[depth++]=length;
+        if(length)normalized[length++]='/';
+        memcpy(normalized+length,start,n);length+=n;
+    }
+    normalized[length]=0;
+    size_t used=strlen(root);
+    if(!used || used>=sizeof(result)){errno=ENAMETOOLONG;return 0;}
+    memcpy(result,root,used+1);
+    while(used>1 && result[used-1]=='/')result[--used]=0;
+    directory=open(root,O_RDONLY|O_DIRECTORY|O_CLOEXEC);
+    if(directory<0)return 0;
+    p=normalized;
+    while(*p) {
+        const char *end=strchr(p,'/');size_t n=end?(size_t)(end-p):strlen(p);
+        char component[MAX_PATH];memcpy(component,p,n);component[n]=0;
+        struct stat st;int found=0;
+#ifndef __APPLE__
+        /* APFS may resolve wrong-case lstat successfully. Host fixtures scan to
+         * check returned spelling; Android exact names need no directory scan. */
+        if(!absent && !fstatat(directory,component,&st,AT_SYMLINK_NOFOLLOW)) {
+            memcpy(actual,component,n+1);found=1;
+        } else if(!absent && errno!=ENOENT) goto done;
+#endif
+        if(!absent && !found) {
+            int copy=dup(directory);if(copy<0)goto done;
+            DIR *entries=fdopendir(copy);if(!entries){close(copy);goto done;}
+            errno=0;struct dirent *entry;
+            while((entry=readdir(entries))) {
+                if(!xbox_ascii_equal(component,entry->d_name))continue;
+                if(found){closedir(entries);errno=EEXIST;goto done;}
+                size_t size=strlen(entry->d_name);
+                if(size>=sizeof(actual)){closedir(entries);errno=ENAMETOOLONG;goto done;}
+                memcpy(actual,entry->d_name,size+1);found=1;
+            }
+            int scan_error=errno;closedir(entries);if(scan_error){errno=scan_error;goto done;}
+            if(found && fstatat(directory,actual,&st,AT_SYMLINK_NOFOLLOW))goto done;
+        }
+        if(found) {
+            if(S_ISLNK(st.st_mode)){errno=ELOOP;goto done;}
+            if(end && !S_ISDIR(st.st_mode)){errno=ENOTDIR;goto done;}
+        } else {
+            if(end && !missing_parents){errno=ENOENT;goto done;}
+            absent=1;memcpy(actual,component,n+1);
+        }
+        size_t size=strlen(actual),separator=used && result[used-1]!='/' ? 1 : 0;
+        if(used+separator+size>=sizeof(result)){errno=ENAMETOOLONG;goto done;}
+        if(separator)result[used++]='/';memcpy(result+used,actual,size+1);used+=size;
+        if(end && !absent) {
+            int next=openat(directory,actual,O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW);
+            if(next<0)goto done;close(directory);directory=next;
+        }
+        if(!end)break;p=end+1;
+    }
+    if(used>=capacity){errno=ENAMETOOLONG;goto done;}
+    memcpy(out,result,used+1);ok=1;
+done:
+    {int error=errno;close(directory);errno=error;}return ok;
+}
