+            for(unsigned block=0;block<r.sizes[level]/block_size;++block){
+                uint8_t *p=data+face*128+r.offsets[level]+block*block_size,*colors=p+(f?8:0);
+                colors[0]=0;colors[1]=0xF8;colors[2]=0x1F;colors[3]=0;
