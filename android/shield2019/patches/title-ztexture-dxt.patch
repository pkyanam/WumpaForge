+++ b/dxt_upload.inc
@@ -0,0 +1,30 @@
+/* DXT storage is sampling-only: SetRenderTarget/CopyRects destination require
+ * format_info>0. Surface source readback still decodes authoritative guest bytes.
+ * Xbox DXT blocks use S3TC's byte layout; cube face padding stays outside levels. */
+static GLenum native_dxt_format(uint32_t format)
+{
+    if(format!=0x0C&&format!=0x0E&&format!=0x0F)return 0;
+    const char *disable=getenv("WRATH_DISABLE_DXT_UPLOAD");
+    if(disable&&!strcmp(disable,"1"))return 0;
+    static int supported=-1; /* One context lifetime; context loss ends this process. */
+    if(supported<0)supported=epoxy_has_gl_extension("GL_EXT_texture_compression_s3tc");
+    if(!supported)return 0;
+    return format==0x0C?0x83F1u:format==0x0E?0x83F2u:0x83F3u;
+}
+static int upload_dxt_levels(const struct Resource *r,GLenum target,unsigned faces,
+                             const uint8_t *encoded,GLenum format,uint64_t *bytes)
+{
+    *bytes=0;
+    for(unsigned face=0;face<faces;++face)for(unsigned level=0;level<r->levels;++level) {
+        unsigned width=r->width>>level,height=r->height>>level;
+        if(!width)width=1;if(!height)height=1;
+        uint64_t size=(uint64_t)((width+3)/4)*((height+3)/4)*(r->format==0x0C?8:16);
+        uint64_t offset=(uint64_t)face*r->face_stride+r->offsets[level];
+        if(size>r->sizes[level]||offset+size>r->bytes||size>0x7fffffffu)return 0;
+        glCompressedTexImage2D(target==GL_TEXTURE_CUBE_MAP?GL_TEXTURE_CUBE_MAP_POSITIVE_X+face:GL_TEXTURE_2D,
+                              (GLint)level,format,width,height,0,(GLsizei)size,encoded+offset);
+        if(glGetError()!=GL_NO_ERROR)return 0;
+        *bytes+=size;
+    }
+    return 1;
+}
