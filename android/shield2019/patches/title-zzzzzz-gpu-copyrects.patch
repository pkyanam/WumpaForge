+/* Android GPU CopyRects: only live GPU authority qualifies. Inactive target
+ * objects can have newer guest bytes and must retain the CPU fallback. */
+struct ShieldGpuCopy {
+    GLuint source, destination;
+    GLint old_read, old_draw, source_buffer, destination_buffer;
+    GLboolean scissor;
+};
+static void shield_gpu_copy_end(const struct ShieldGpuCopy *copy)
+{
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,copy->source);
+    glReadBuffer(copy->source_buffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,copy->destination);
+    glDrawBuffer(copy->destination_buffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,copy->old_read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,copy->old_draw);
+    if(copy->scissor)glEnable(GL_SCISSOR_TEST);
+}
+static int shield_gpu_copy_begin(struct Resource *source,struct Resource *destination,
+                                 struct ShieldGpuCopy *copy)
+{
+    static int enabled=-1;
+    if(enabled<0) { const char *mode=getenv("WRATH_GPU_COPYRECTS");enabled=mode && !strcmp(mode,"1"); }
+    if(!enabled)return 0;
+    struct Resource *src=surface_gpu_storage(source),*dst=surface_gpu_storage(destination);
+    if(!src || !dst || src==dst || source->format!=destination->format ||
+       (source->format!=0x06 && source->format!=0x12) ||
+       !source->width || !source->height || !destination->width || !destination->height ||
+       source->width>INT32_MAX || source->height>INT32_MAX ||
+       destination->width>INT32_MAX || destination->height>INT32_MAX ||
+       (source->owner && source->owner==destination->owner) ||
+       ((uint64_t)source->data+source->bytes>destination->data &&
+        (uint64_t)destination->data+destination->bytes>source->data) ||
+       (src->target_texture && src->target_texture==dst->target_texture))return 0;
+    copy->source=src->framebuffer?xbox_D3D8GLBackBuffer(src->framebuffer==GL_FRONT):src->target_fbo;
+    copy->destination=dst->framebuffer?xbox_D3D8GLBackBuffer(dst->framebuffer==GL_FRONT):dst->target_fbo;
+    if(!copy->source || !copy->destination || copy->source==copy->destination)return 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&copy->old_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&copy->old_draw);
+    copy->scissor=glIsEnabled(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,copy->source);
+    glGetIntegerv(GL_READ_BUFFER,&copy->source_buffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,copy->destination);
+    glGetIntegerv(GL_DRAW_BUFFER,&copy->destination_buffer);
+    /* Check before the first write so an incomplete FBO takes the old path. */
+    if(glCheckFramebufferStatus(GL_READ_FRAMEBUFFER)!=GL_FRAMEBUFFER_COMPLETE ||
+       glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER)!=GL_FRAMEBUFFER_COMPLETE) {
+        shield_gpu_copy_end(copy);return 0;
+    }
+    glReadBuffer(GL_COLOR_ATTACHMENT0);glDrawBuffer(GL_COLOR_ATTACHMENT0);
+    glDisable(GL_SCISSOR_TEST);
+    return 1;
+}
+static void shield_gpu_copy_rect(const struct Resource *source,const struct Resource *destination,
+                                 const D3DRECT *rect,const int32_t point[2])
+{
+    int width=rect->x2-rect->x1,height=rect->y2-rect->y1;
+    /* Both existing surfaces use GL bottom-first storage. The CPU fallback
+     * reverses at readback and staging upload; direct copies reverse neither. */
+    glBlitFramebuffer(rect->x1,source->height-rect->y2,rect->x2,source->height-rect->y1,
+                      point[0],destination->height-point[1]-height,
+                      point[0]+width,destination->height-point[1],GL_COLOR_BUFFER_BIT,GL_NEAREST);
+}
