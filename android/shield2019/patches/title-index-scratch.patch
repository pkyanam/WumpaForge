+++ b/index_scratch.inc
@@ -0,0 +1,29 @@
+/* All indexed draws hold the recursive graphics mutex. Borrow at most 1MiB
+ * between draws; oversized or nested draws retain the original temporary path. */
+#define INDEX_SCRATCH_LIMIT (1024u * 1024u)
+struct IndexScratchLease { uint8_t *data; int retained; };
+static uint8_t *s_index_scratch;
+static size_t s_index_scratch_capacity;
+static int s_index_scratch_busy;
+static struct IndexScratchLease index_scratch_acquire(size_t size)
+{
+    struct IndexScratchLease lease={NULL,0};
+    if(!size)return lease;
+    if(!s_index_scratch_busy&&size<=INDEX_SCRATCH_LIMIT) {
+        if(size>s_index_scratch_capacity) {
+            size_t capacity=s_index_scratch_capacity?s_index_scratch_capacity:4096;
+            while(capacity<size)capacity*=2;
+            uint8_t *grown=realloc(s_index_scratch,capacity);
+            if(grown){s_index_scratch=grown;s_index_scratch_capacity=capacity;}
+        }
+        if(size<=s_index_scratch_capacity) {
+            s_index_scratch_busy=1;lease.data=s_index_scratch;lease.retained=1;return lease;
+        }
+    }
+    lease.data=malloc(size);return lease;
+}
+static void index_scratch_release(struct IndexScratchLease lease)
+{
+    if(lease.retained)s_index_scratch_busy=0;
+    else free(lease.data);
+}
