+}
+/* Scoped host callback profiling: return only this body's draw delta and
+ * retain unrelated owner counters. The caller merges after synchronous return. */
+void xbox_D3D8GLProfileHostCall(void (*callback)(void *),void *argument,uint64_t delta[2])
+{
+    uint64_t draws=g_profile_calls.draws,time=g_profile_calls.draw_time;
+    callback(argument);
+    delta[0]=g_profile_calls.draws-draws;delta[1]=g_profile_calls.draw_time-time;
+    g_profile_calls.draws=draws;g_profile_calls.draw_time=time;
+}
+void xbox_D3D8GLProfileMergeDraw(const uint64_t delta[2])
+{
+    g_profile_calls.draws+=delta[0];g_profile_calls.draw_time+=delta[1];
 }
