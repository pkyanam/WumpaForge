+++ b/index_resource_bounds.inc
@@ -0,0 +1,37 @@
+/* Rebuild only after native resource lifetime changes; all draw calls hold the
+ * graphics mutex. Keep every overlapping candidate and the inclusive end test. */
+static struct Resource **s_index_candidates;
+static unsigned s_index_candidate_count, s_index_candidate_capacity;
+static int index_resource_bounds(uint32_t indices,uint32_t count)
+{
+    unsigned capacity=resource_capacity();
+    if(s_index_resource_dirty) {
+        if(capacity>s_index_candidate_capacity) {
+            struct Resource **list=realloc(s_index_candidates,(size_t)capacity*sizeof(*list));
+            if(!list)goto uncached;
+            s_index_candidates=list;s_index_candidate_capacity=capacity;
+        }
+        s_index_candidate_count=0;
+        for(unsigned i=0;i<capacity;++i) {
+            struct Resource *r=resource_at(i);
+            if(r->handle&&r->type==RESOURCE_INDEX_BUFFER)
+                s_index_candidates[s_index_candidate_count++]=r;
+        }
+        s_index_resource_dirty=0;
+    }
+    for(unsigned i=0;i<s_index_candidate_count;++i) {
+        const struct Resource *r=s_index_candidates[i];
+        if(indices>=r->data&&(uint64_t)indices<=(uint64_t)r->data+r->bytes&&
+           (uint64_t)indices+(uint64_t)count*2>(uint64_t)r->data+r->bytes)return 0;
+    }
+    return 1;
+ uncached:
+    /* Allocation failure preserves the original complete bounds check. */
+    for(unsigned i=0;i<capacity;++i) {
+        const struct Resource *r=resource_at(i);
+        if(r->handle&&r->type==RESOURCE_INDEX_BUFFER&&indices>=r->data&&
+           (uint64_t)indices<=(uint64_t)r->data+r->bytes&&
+           (uint64_t)indices+(uint64_t)count*2>(uint64_t)r->data+r->bytes)return 0;
+    }
+    return 1;
+}
