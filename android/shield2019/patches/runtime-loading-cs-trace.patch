 extern RECOMP_TLS uint32_t g_xbox_kernel_caller;
 
+/* Opt-in, bounded diagnostics armed only when the loading worker begins.
+ * No lock behavior changes, forced releases, or guest-memory writes. */
+extern int wumpa_cs_last_unlock_result(void);
+static int wumpa_cs_trace_enabled(void)
+{
+    static _Atomic int cached=-1;
+    int enabled=atomic_load_explicit(&cached,memory_order_relaxed);
+    if(enabled>=0)return enabled;
+    const char *v=getenv("WRATH_TRACE_LOADING_CS");
+    enabled=v && !strcmp(v,"outer") ? 2 : v && !strcmp(v,"1");
+    atomic_store_explicit(&cached,enabled,memory_order_relaxed);return enabled;
+}
+static void wumpa_cs_trace(const char *event, PRTL_CRITICAL_SECTION guest,
+                           long depth, int result)
+{
+    static _Atomic unsigned armed,records;
+    if((uint32_t)((uintptr_t)guest-(uintptr_t)g_xbox_mem_offset)!=0x4EA440u)return;
+    int mode=wumpa_cs_trace_enabled();
+    if(!mode)return;
+    /* Keep the outer worker ownership pairs across later level loads. Nested
+     * render calls must not consume this diagnostic mode's record budget. */
+    if(mode==2 && g_xbox_kernel_caller!=0x2BF67u &&
+       g_xbox_kernel_caller!=0x2BFF6u)return;
+    if(g_xbox_kernel_caller==0x2BF67u)atomic_store_explicit(&armed,1,memory_order_relaxed);
+    if(!atomic_load_explicit(&armed,memory_order_relaxed))return;
+    unsigned record=atomic_fetch_add_explicit(&records,1,memory_order_relaxed);
+    if(record>=3000)return;
+    fprintf(stderr,"[shield cs] n=%u %s guest_tid=%u native_tid=%d site=0x%08X depth=%ld result=%d\n",
+            record,event,GetCurrentThreadId(),(int)gettid(),g_xbox_kernel_caller,depth,result);
+}
