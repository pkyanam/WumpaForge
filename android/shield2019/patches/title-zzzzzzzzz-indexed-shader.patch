+/* Called only after the original full index and stream0 bounds checks.
+ * Keep every uncertain layout on the established expansion path. */
+static int indexed_shader_eligible(uint32_t type,uint32_t count,uint32_t stride,uint32_t maximum)
+{
+    const char *mode=getenv("WRATH_INDEXED_SHADER");
+    if(!mode || strcmp(mode,"1") || type!=5 || count%3 || !s_vertex_handle)
+        return 0;
+    for(unsigned i=0;i<16;++i) {
+        const Nv2aVertexSlot *slot=&s_vertex_object.slots[i];
+        if(slot->kind!=NV2A_VERTEX_NONE && (slot->stream || slot->tessellation_type))return 0;
+    }
+    /* Raw indices avoid remapping work; sparse draws retain expansion rather
+     * than uploading a larger contiguous region. Arithmetic stays 64-bit. */
+    return ((uint64_t)maximum+1)*stride+(uint64_t)count*2<=(uint64_t)count*stride;
+}
